# Cấu hình Supabase (Tùy chọn - nếu để trống app sẽ chạy local state tự động)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Cấu hình tài khoản ngân hàng thụ hưởng (VietQR)
NEXT_PUBLIC_DEFAULT_BANK_NAME="Vietcombank (Ngân hàng TMCP Ngoại Thương Việt Nam)"
NEXT_PUBLIC_DEFAULT_ACCOUNT_NUMBER="9988776655"
NEXT_PUBLIC_DEFAULT_ACCOUNT_HOLDER="VI VIEN KHAI VAN ZEN PCC"
NEXT_PUBLIC_DEFAULT_BANK_BIN="970436"

# Cấu hình webhook thanh toán tự động trong tương lai (SePay / Casso / PayOS)
SEPAY_API_KEY=""
CASSO_API_KEY=""
PAYOS_CLIENT_ID=""
PAYOS_API_KEY=""
